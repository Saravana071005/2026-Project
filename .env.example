# ========================================================
# Root Environment Configuration Template
# ========================================================

# MongoDB Atlas Connection URI
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/food_allergy_detection?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_characters

# Server Port
PORT=5000

# Client Application URL
CLIENT_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

# Optional Cloud OCR Provider (Intelligent Document Recognition)
# GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key_here
