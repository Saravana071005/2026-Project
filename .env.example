# ========================================================
# Food Allergy Detection System - Environment Variables
# ========================================================

# --------------------------------------------------------
# Backend Configuration (backend/.env)
# --------------------------------------------------------

# MongoDB Atlas Connection URI
# Obtain from MongoDB Atlas: Database -> Connect -> Drivers (Node.js)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/food_allergy_detection?retryWrites=true&w=majority

# JWT Authentication Secret Key (Minimum 32 random characters recommended)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_characters

# Backend Port (Render sets this dynamically via process.env.PORT)
PORT=5000

# Client Application URL (For CORS validation)
# Local: http://localhost:5173
# Production: https://your-frontend-service.onrender.com
CLIENT_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

# --------------------------------------------------------
# Frontend Configuration (frontend/.env)
# --------------------------------------------------------

# Backend API Endpoint URL
# Local Development: Leave empty to use Vite proxy (/api)
# Production Deployment: https://your-backend-service.onrender.com/api
VITE_API_URL=
