# MongoDB Atlas Connection URI
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/food_allergy_detection?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/food_allergy_detection?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_characters

# Server Port
PORT=5000

# Client Application URL (for CORS)
CLIENT_URL=http://localhost:5173
