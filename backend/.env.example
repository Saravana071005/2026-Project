# ========================================================
# Backend Environment Configuration Template
# ========================================================

# MongoDB Atlas Connection URI
# IMPORTANT: In MongoDB Atlas, cluster hostnames have a unique cluster shard ID (e.g. cluster0.abcde.mongodb.net).
# DO NOT use "cluster0.mongodb.net" without your cluster's unique alphanumeric shard identifier,
# or DNS lookups will fail with: "querySrv ENOTFOUND _mongodb._tcp.cluster0.mongodb.net"
#
# Obtain from MongoDB Atlas: Database -> Connect -> Drivers (Node.js) -> Copy connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/food_allergy_detection?retryWrites=true&w=majority

# JWT Authentication Secret (Minimum 32 random characters recommended)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_characters

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=5000

# Client Application URL (For CORS validation)
# Local: http://localhost:5173
# Production on Render: https://your-frontend-service.onrender.com
CLIENT_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

# --------------------------------------------------------
# Optional Cloud OCR & Document Intelligence Providers
# --------------------------------------------------------
# Google Cloud Vision API Key (Optional: if omitted, built-in high-accuracy Tesseract.js is used automatically)
# GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key_here

# --------------------------------------------------------
# Multi-Provider Medical AI Architecture
# --------------------------------------------------------
# Configurable Primary & Fallback Providers: 'openai', 'gemini', 'august', or 'clinical_grounded_engine'
AI_PRIMARY_PROVIDER=openai
AI_FALLBACK_PROVIDER=gemini

# Provider 1: OpenAI (Official developer API)
# API Key from https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Provider 2: Google Gemini (Official developer API)
# API Key from https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Provider 3: August AI (https://www.meetaugust.ai/)
# IMPORTANT: August AI (August Labs Inc.) is a direct-to-consumer AI health companion and does not
# provide public self-service developer endpoints. Third-party integration requires an authorized
# enterprise partnership agreement and designated clinical gateway endpoint directly from August Labs Inc.
# Do NOT invent endpoints or scrape private app interfaces.
# AUGUST_AI_API_KEY=your_authorized_august_partner_key
# AUGUST_AI_API_ENDPOINT=https://partner-gateway.meetaugust.ai/v1/clinical-consult
# AUGUST_AI_PARTNER_ID=your_partner_organization_id

