# ========================================================
# Backend Environment Configuration Template
# ========================================================

# MongoDB Atlas Connection URI
# IMPORTANT: In MongoDB Atlas, cluster hostnames have a unique cluster shard ID (e.g. cluster0.abcde.mongodb.net).
# DO NOT use "cluster0.mongodb.net" without your cluster's unique alphanumeric shard identifier,
# or DNS lookups will fail with: "querySrv ENOTFOUND _mongodb._tcp.cluster0.mongodb.net"
#
# Obtain from MongoDB Atlas: Database -> Connect -> Drivers (Node.js) -> Copy connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/food_allergy_detection?retryWrites=true&w=majority

# JWT Authentication Secret (Minimum 32 random characters recommended)
JWT_SECRET=replace_with_a_secure_jwt_secret_key_minimum_32_characters

# Server Port (Render sets this dynamically via process.env.PORT)
PORT=5000

# Client Application URL (For CORS validation)
# Local: http://localhost:5173
# Production on Render: https://your-frontend-service.onrender.com
CLIENT_URL=http://localhost:5173

# Node Environment ('development' or 'production')
NODE_ENV=development

# --------------------------------------------------------
# Optional Cloud OCR & Document Intelligence Providers
# --------------------------------------------------------
# Google Cloud Vision API Key (Optional: if omitted, built-in high-accuracy Tesseract.js is used automatically)
# GOOGLE_VISION_API_KEY=your_google_cloud_vision_api_key_here
